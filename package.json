{
  "name": "kpaas-tech",
  "version": "1.0.0",
  "description": "K'paas Tech Pack - Single Page React Application with TypeScript",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
